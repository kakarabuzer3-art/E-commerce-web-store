# Use the existing admin database name here to share the same database.
# Store tables use the sc_ prefix so they do not overwrite existing tables.
STORE_DB_HOST=127.0.0.1
STORE_DB_PORT=3306
STORE_DB_NAME=sunday_club
STORE_DB_USER=root
STORE_DB_PASSWORD=

# Set a long, unique random value to enable admin inventory/order management.
STORE_ADMIN_TOKEN=
